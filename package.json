{
  "name": "fractalcam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time generative virtual webcam: webcam -> WebGL2 shaders -> clean output window -> OBS Virtual Camera",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "node tests/e2e/run.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
